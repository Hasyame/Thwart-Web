{
  "name": "thwart-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web companion for Thwart, the Marvel Champions card game app.",
  "license": "MIT",
  "scripts": {
    "data": "node scripts/fetch-cards.mjs",
    "theme": "node scripts/generate-theme.mjs",
    "prepare-assets": "npm run theme && npm run data",
    "dev": "npm run theme && vite",
    "build": "npm run theme && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.3.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.4",
    "svelte": "^5.42.2",
    "svelte-check": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
