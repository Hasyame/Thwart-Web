# /etc/systemd/system/thwart-api.service
#
#   sudo systemctl enable --now thwart-api
#
# One Go binary, one SQLite file, listening on loopback. nginx terminates TLS
# and proxies /api/ to it; nothing outside the box can reach this port.

[Unit]
Description=Thwart account and sync API
Documentation=https://github.com/Hasyame/Thwart-Web
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=thwart
Group=thwart
WorkingDirectory=/srv/thwart

# `-registration` was false while there was no way to prove an address belonged
# to the person who typed it: an open endpoint with no confirmation is a table
# of invented accounts waiting to happen. Confirmation closes that, so the door
# opens again. What stands behind it now is a link that has to be opened before
# the account does anything, five registrations an hour per address, and a sweep
# that deletes anything nobody confirmed within eight days.
#
# Set it back to false to close the instance. The accounts that already exist
# still sign in, and a lost password is still recovered with its code: closing
# an instance must not lock out the person whose account it is.
#
# `-mail-from` is what turns address confirmation on. With it set, a new account
# is disabled until somebody opens the link sent to the address they registered
# with, and an account nobody confirms is deleted a week later. Without it the
# binary sends nothing and confirms nothing, which is the right behaviour for a
# self-hosted instance with no MTA.
#
# The mail itself goes to the Postfix on the loopback that deploy/mail.sh sets
# up. That hop has no authentication, which is safe only because it never leaves
# the machine — NewSMTPMailer refuses any host that is not local.
ExecStart=/srv/thwart/bin/thwart-api \
  -addr 127.0.0.1:8787 \
  -db /srv/thwart/db/thwart.sqlite \
  -registration=true \
  -mail-from "Thwart <no-reply@thwart.app>" \
  -smtp 127.0.0.1:25 \
  -site https://thwart.app

# The binary handles SIGTERM by draining in-flight requests, which for a
# password change is the difference between a clear outcome and one nobody can
# explain afterwards. Give it room to finish.
KillSignal=SIGTERM
TimeoutStopSec=30

# Long-lived connections, one file descriptor each.
#
# The live sync stream holds a socket open per signed-in browser, and nginx
# holds a matching one upstream. The default 1024 is close enough to matter at a
# few hundred users, and the failure mode is "accept: too many open files" —
# which refuses ordinary requests, not just streams.
LimitNOFILE=8192

Restart=on-failure
RestartSec=5s

# Logs are JSON on stdout, so journalctl has them and nothing writes a file
# that needs rotating.
StandardOutput=journal
StandardError=journal

# ---- memory ----------------------------------------------------------------
# Argon2id is configured at 64 MiB per hash (auth.go), and a login runs one. On
# a small VPS the cap has to leave room for several at once plus the Go heap
# and SQLite's page cache. MemoryHigh throttles before MemoryMax kills, so a
# burst slows down instead of the service disappearing.
#
# Doc 05 says to tune these on the actual machine. If logins start failing
# under load, this is the first number to look at.
MemoryHigh=384M
MemoryMax=512M

# ---- hardening -------------------------------------------------------------
# It needs to write exactly one directory and open exactly one socket.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

# The database, the WAL and the shared-memory file all live here.
ReadWritePaths=/srv/thwart/db

# Loopback only, so no need for anything but IPv4 and IPv6.
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressAllow=localhost
IPAddressDeny=any

CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
